<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
<hashTree>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="LDAP load test - admin + user lifecycle">
<stringProp name="TestPlan.comments">Settings come from ldap-simple.properties (-q). Native LDAP samplers only. Sample labels start with the LDAP operation (BIND, SEARCH, ADD, MODIFY, DELETE, UNBIND).</stringProp>
<boolProp name="TestPlan.functional_mode">false</boolProp>
<elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
<collectionProp name="Arguments.arguments">
<elementProp name="TESTOU" elementType="Argument"><stringProp name="Argument.name">TESTOU</stringProp><stringProp name="Argument.value">${__P(ldap.testOuDN,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
</collectionProp>
</elementProp>
</TestPlan>
<hashTree>
<ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="LDAP flow (bind, search, N cycles, unbind)" enabled="true">
<stringProp name="ThreadGroup.num_threads">${__P(ldap.threads,1)}</stringProp>
<stringProp name="ThreadGroup.ramp_time">${__P(ldap.rampSec,1)}</stringProp>
<boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
<stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
<elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
<stringProp name="LoopController.loops">${__P(ldap.passes,1)}</stringProp>
<boolProp name="LoopController.continue_forever">false</boolProp>
</elementProp>
</ThreadGroup>
<hashTree>
<LDAPExtSampler guiclass="LdapExtTestSamplerGui" testclass="LDAPExtSampler" testname="BIND - 01 admin" enabled="true">
<stringProp name="servername">${__P(ldap.host,)}</stringProp>
<stringProp name="port">${__P(ldap.port,1636)}</stringProp>
<stringProp name="rootdn">${TESTOU}</stringProp>
<stringProp name="scope">1</stringProp>
<stringProp name="countlimit">0</stringProp>
<stringProp name="timelimit">0</stringProp>
<stringProp name="attributes"></stringProp>
<stringProp name="return_object">false</stringProp>
<stringProp name="deref_aliases">false</stringProp>
<stringProp name="connection_timeout">${__P(ldap.connectTimeoutMs,5000)}</stringProp>
<stringProp name="parseflag">false</stringProp>
<stringProp name="secure">true</stringProp>
<stringProp name="trustall">true</stringProp>
<stringProp name="user_dn">${__P(ldap.bindDN,)}</stringProp>
<stringProp name="user_pw">${__P(ldap.bindPw,)}</stringProp>
<stringProp name="comparedn"></stringProp>
<stringProp name="comparefilt"></stringProp>
<stringProp name="modddn"></stringProp>
<stringProp name="newdn"></stringProp>
<stringProp name="test">bind</stringProp>

</LDAPExtSampler>
<hashTree/>
<IfController guiclass="IfControllerPanel" testclass="IfController" testname="Admin bind succeeded?" enabled="true">
<stringProp name="IfController.condition">${__jexl3(ctx.getPreviousResult().isSuccessful())}</stringProp>
<boolProp name="IfController.evaluateAll">false</boolProp>
<boolProp name="IfController.useExpression">true</boolProp>
</IfController>
<hashTree>
<LDAPExtSampler guiclass="LdapExtTestSamplerGui" testclass="LDAPExtSampler" testname="SEARCH - 02 admin, test OU" enabled="true">
<stringProp name="servername"></stringProp>
<stringProp name="port"></stringProp>
<stringProp name="rootdn">${TESTOU}</stringProp>
<stringProp name="scope">0</stringProp>
<stringProp name="countlimit">0</stringProp>
<stringProp name="timelimit">0</stringProp>
<stringProp name="attributes">1.1</stringProp>
