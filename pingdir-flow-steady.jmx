<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="PingDirectory flow - steady rate">
      <stringProp name="TestPlan.comments">Settings come from settings.properties, sent to engines with -G. Native LDAP samplers only (no scripting, works on any Java). Each flow thread has a partner thread that holds the user&apos;s own connection. Holds pd.flowsPerSec (total across engines) until you stop the test.</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="TESTOU" elementType="Argument">
            <stringProp name="Argument.name">TESTOU</stringProp>
            <stringProp name="Argument.value">${__P(pd.testOuDN,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RUNID" elementType="Argument">
            <stringProp name="Argument.name">RUNID</stringProp>
            <stringProp name="Argument.value">${__time(yyMMddHHmmss,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
