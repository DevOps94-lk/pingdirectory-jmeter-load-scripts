          <stringProp name="rootdn">${BASEDN}</stringProp>
          <stringProp name="test">delete</stringProp>
          <stringProp name="delete">uid=e-${RUNID}-${__counter(TRUE,)}</stringProp>
          <stringProp name="base_entry_dn">uid=e-${RUNID}-${__counter(TRUE,)}</stringProp>
          <stringProp name="scope">2</stringProp>
          <stringProp name="countlim">0</stringProp>
