        <stringProp name="ThreadGroup.duration">${__P(pd.durationSec,1800)}</stringProp>
        <stringProp name="ThreadGroup.delay">${__P(pd.deleteStartDelaySec,10)}</stringProp>
      </ThreadGroup>
