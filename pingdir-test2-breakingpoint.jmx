          <stringProp name="rootdn">${BASEDN}</stringProp>
          <stringProp name="test">search</stringProp>
          <stringProp name="search"></stringProp>
          <stringProp name="searchfilter">${__P(pd.searchFilter,(uid=tommytester))}</stringProp>
