          <stringProp name="base_entry_dn">${__P(pd.modifyTargetDN,uid=tommytester)}</stringProp>
          <elementProp name="ldaparguments" elementType="LDAPArguments" guiclass="org.apache.jmeter.protocol.ldap.config.gui.LDAPArgumentsPanel" testclass="LDAPArguments" testname="LDAPArguments" enabled="true">
            <collectionProp name="Arguments.arguments">
            <elementProp name="sn" elementType="LDAPArgument">
              <stringProp name="Argument.name">sn</stringProp>
              <stringProp name="Argument.value">modified-${__time()}</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
              <stringProp name="Argument.opcode">replace</stringProp>
              <stringProp name="Argument.desc"></stringProp>
            </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="scope">2</stringProp>
          <stringProp name="countlimit">0</stringProp>
          <stringProp name="timelimit">0</stringProp>
          <stringProp name="attributes"></stringProp>
          <boolProp name="return_object">false</boolProp>
          <boolProp name="deref_aliases">false</boolProp>
          <boolProp name="parseflag">false</boolProp>
          <stringProp name="connection_timeout">5000</stringProp>
        </org.apache.jmeter.protocol.ldap.sampler.LDAPExtSampler>
        <hashTree>
          <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="Rate (samples/min)" enabled="true">
            <intProp name="calcMode">4</intProp>
            <stringProp name="throughput">${__jexl3( ${__P(pd.modifyPerSec,0)} &gt; 0 ? ((${__P(pd.modifyPerSec,0)} * 60.0) * (1 + (${__P(pd.rampStepPercent,30)}/100.0) * ((${__time()} - ${START})/1000.0/${__P(pd.rampStepSeconds,120)}))) : 0.001 )}</stringProp>
          </ConstantThroughputTimer>
          <hashTree/>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Reconnect if connection lost" enabled="true">
          <stringProp name="IfController.condition">${__jexl3(!ctx.getPreviousResult().isSuccessful() &amp;&amp; ctx.getPreviousResult().getResponseCode() == "800")}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
        <org.apache.jmeter.protocol.ldap.sampler.LDAPExtSampler guiclass="org.apache.jmeter.protocol.ldap.control.gui.LdapExtTestSamplerGui" testclass="org.apache.jmeter.protocol.ldap.sampler.LDAPExtSampler" testname="Reconnect" enabled="true">
          <stringProp name="servername">${__P(pd.hostWrite,localhost)}</stringProp>
          <stringProp name="port">${__P(pd.port,1636)}</stringProp>
          <stringProp name="rootdn">${BASEDN}</stringProp>
          <stringProp name="test">bind</stringProp>
          <boolProp name="secure">true</boolProp>
          <boolProp name="trustall">true</boolProp>
          <stringProp name="user_dn">${__P(pd.bindDN,)}</stringProp>
          <stringProp name="user_pw">${__P(pd.bindPw,)}</stringProp>
          <stringProp name="scope">2</stringProp>
          <stringProp name="countlimit">0</stringProp>
          <stringProp name="timelimit">0</stringProp>
          <stringProp name="attributes"></stringProp>
          <boolProp name="return_object">false</boolProp>
          <boolProp name="deref_aliases">false</boolProp>
          <boolProp name="parseflag">false</boolProp>
          <stringProp name="connection_timeout">5000</stringProp>
        </org.apache.jmeter.protocol.ldap.sampler.LDAPExtSampler>
        <hashTree/>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
